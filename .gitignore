node_modules/
*.log
.DS_Store

# Local working / session-handoff notes — not part of the shipped artifact
HANDOFF.md
HANDOFF-*.md

# Local credentials — never commit
.env
.env.*
.npmrc
.gitignore.bak
docs/statusline.html
docs/statusline-wrap.html

handoff/
logs/

# Generated by scripts/build-site-docs.mjs — rebuilt in CI, not committed.
site/docs/
site/statusline.png

# graphify knowledge graph (regenerable, local)
graphify-out/

# Local video working directory (not part of the shipped artifact), except the product tour sources
/video/*
!/video/tour/
/video/tour/clips/
/video/tour/out/
/video/tour/recorder/node_modules/

# A tool outside sprag writes `:memory:.ses` (timestamp + session id) into the
# working directory of some Codex sessions; it is not a project file.
:memory:.ses

# Claude Code writes the mod API types beside a mod it loads from this folder
# (a dev session with --plugin-dir, or an `npm link` install). Regenerated on
# every load, so never committed; package.json `files` leaves them out too.
mod/*/.claude-plugin/types/
mod/*/tsconfig.json

# Working notes that never belonged in the published tree: design sketches,
# launch drafts and the rename roadmap stay local to the maintainer.
docs/_*.md
docs/LAUNCH-POSTS.md
docs/DISCUSSION-pinned-draft.md
docs/RENAME-SPRAG.md
