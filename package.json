{
  "name": "sprag-cli",
  "version": "3.53.0",
  "description": "Sprag - a local harness for Claude Code and Codex: ratchet rules, model delegation, token telemetry, companion panels, document conversion, and Korean writing checks.",
  "type": "module",
  "bin": {
    "sprag": "bin/cli.js",
    "claude-token-saver": "bin/cli.js"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "docs:statusline": "node scripts/docs-statusline.mjs",
    "postinstall": "node bin/cli.js install || true",
    "publish:legacy": "node scripts/publish-legacy.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "site:docs": "node scripts/build-site-docs.mjs",
    "test": "node --test"
  },
  "files": [
    "bin/",
    "src/",
    "presets/",
    "examples/",
    "README.md",
    "README.ko.md",
    "docs/CODEX.md",
    "docs/CODEX.ko.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sprag",
    "ratchet",
    "harness",
    "ai-agent",
    "claude",
    "claude-code",
    "codex",
    "openai-codex",
    "agents-md",
    "anthropic",
    "model-routing",
    "llm-router",
    "delegation",
    "subagent",
    "haiku",
    "cost-savings",
    "token-usage",
    "prompt-caching",
    "cache",
    "statusline",
    "cli",
    "1m-context",
    "claude-code-statusline",
    "claude-code-cost",
    "model-fitting",
    "agent-harness"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootstudioyaml/sprag.git"
  },
  "homepage": "https://sprag.io",
  "bugs": {
    "url": "https://github.com/rootstudioyaml/sprag/issues"
  },
  "author": "DeepPulse (https://www.youtube.com/@DeepPulseKR)",
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
