{
  "name": "sprag-cli",
  "version": "3.79.0",
  "description": "Model-delegation router for Claude Code and Codex: lookups, checks and test runs go to cheaper models, documents go in as compact Markdown, and a live statusline shows spend and savings.",
  "type": "module",
  "bin": {
    "sprag": "bin/cli.js",
    "claude-token-saver": "bin/cli.js"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "docs:statusline": "node scripts/docs-statusline.mjs",
    "postinstall": "node bin/postinstall.js || true",
    "presets:pull": "node scripts/presets-pull.mjs",
    "publish:legacy": "node scripts/publish-legacy.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "site:docs": "node scripts/build-site-docs.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "test": "node --test",
    "test:mods": "claude plugin test mod/sprag-doc2md && claude plugin test mod/sprag-delegation-meter && claude plugin test mod/sprag-statusline",
    "version": "node scripts/sync-site-version.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "mod/*/.claude-plugin/plugin.json",
    "mod/*/hooks/**",
    "mod/*/types/**",
    "presets/",
    "examples/",
    "README.md",
    "README.ko.md",
    "docs/CODEX.md",
    "docs/CODEX.ko.md",
    "docs/TEAM.md",
    "docs/TEAM.ko.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "codex",
    "token-usage",
    "token-saver",
    "reduce-tokens",
    "cost-savings",
    "claude-code-cost",
    "claude-code-statusline",
    "statusline",
    "model-routing",
    "model-router",
    "model-delegation",
    "llm-router",
    "claude-code-router",
    "subagent",
    "prompt-caching",
    "haiku",
    "cli",
    "token",
    "tokens",
    "cost",
    "llm-cost",
    "cost-optimization",
    "openai-codex",
    "pptx-to-markdown"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootstudioyaml/sprag.git"
  },
  "homepage": "https://sprag.io",
  "bugs": {
    "url": "https://github.com/rootstudioyaml/sprag/issues"
  },
  "author": "DeepPulse (https://www.youtube.com/@DeepPulseKR)",
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
