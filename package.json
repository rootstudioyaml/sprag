{
  "name": "sprag-cli",
  "version": "3.58.0",
  "description": "Lower your Claude Code bill without changing how you work: simple tasks go to cheaper models, documents go in as compact Markdown, and the statusline shows spend and savings live. Works with Codex too.",
  "type": "module",
  "bin": {
    "sprag": "bin/cli.js",
    "claude-token-saver": "bin/cli.js"
  },
  "scripts": {
    "deploy": "node scripts/deploy.mjs",
    "docs:statusline": "node scripts/docs-statusline.mjs",
    "postinstall": "node bin/postinstall.js || true",
    "publish:legacy": "node scripts/publish-legacy.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "site:docs": "node scripts/build-site-docs.mjs",
    "test": "node --test",
    "version": "node scripts/sync-site-version.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "presets/",
    "examples/",
    "README.md",
    "README.ko.md",
    "docs/CODEX.md",
    "docs/CODEX.ko.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "codex",
    "token-usage",
    "token-saver",
    "reduce-tokens",
    "cost-savings",
    "claude-code-cost",
    "claude-code-statusline",
    "statusline",
    "model-routing",
    "subagent",
    "prompt-caching",
    "haiku",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootstudioyaml/sprag.git"
  },
  "homepage": "https://sprag.io",
  "bugs": {
    "url": "https://github.com/rootstudioyaml/sprag/issues"
  },
  "author": "DeepPulse (https://www.youtube.com/@DeepPulseKR)",
  "dependencies": {
    "smol-toml": "^1.9.0"
  }
}
